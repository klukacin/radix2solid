{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "packages/*/src",
    "packages/*/vite.config.ts",
    "apps/*/src",
    "apps/*/scripts",
    "apps/*/vite.config.ts",
    "tests",
    "e2e",
    "playwright.config.ts",
    "oxlint.config.ts"
  ]
}

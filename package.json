{
  "name": "radix-solid-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --filter @wsagency/radix2solid-primitives build && pnpm --filter @wsagency/radix2solid-icons build && pnpm --filter @wsagency/radix2solid-themes build && pnpm --filter @wsagency/radix2solid-charts build && pnpm --filter @radix-solid/gallery build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "test": "node --test tests/slider.test.ts && pnpm test:consumer && playwright test",
    "test:consumer": "node tests/consumer/run.ts",
    "dev": "pnpm --filter @radix-solid/gallery dev"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@radix-ui/colors": "3.0.0",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@solidjs/web": "2.0.0-rc.15",
    "@types/node": "24.19.1",
    "@wsagency/radix2solid-charts": "workspace:*",
    "@wsagency/radix2solid-icons": "workspace:*",
    "@wsagency/radix2solid-primitives": "workspace:*",
    "@wsagency/radix2solid-themes": "workspace:*",
    "axe-core": "4.11.0",
    "eslint-plugin-solid": "0.18.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "solid-js": "2.0.0-rc.15",
    "typescript": "7.0.2",
    "typescript5": "npm:typescript@5.9.3",
    "vite": "8.3.3"
  }
}

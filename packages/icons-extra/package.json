{
  "name": "@wsagency/radix2solid-icons-extra",
  "version": "0.1.0-rc.3",
  "private": false,
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/", "tag": "next" },
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/wsagency/radix2solid.git", "directory": "packages/icons-extra" },
  "homepage": "https://github.com/wsagency/radix2solid/tree/main/packages/icons-extra#readme",
  "bugs": { "url": "https://github.com/wsagency/radix2solid/issues" },
  "files": ["dist", "icons", "LICENSE", "README.md", "CHANGELOG.md"],
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/types/index.d.ts", "browser": "./dist/client/index.js", "default": "./dist/server/index.js" },
    "./icons/*.svg": "./icons/*.svg",
    "./*Icon": { "types": "./dist/types/*Icon.d.ts", "browser": "./dist/client/*Icon.js", "default": "./dist/server/*Icon.js" }
  },
  "scripts": {
    "generate": "node ../icons/scripts/generate.ts .",
    "build": "pnpm generate && vite build && vite build --ssr && tsc -p tsconfig.json"
  },
  "peerDependencies": { "solid-js": "2.0.0-rc.15", "@solidjs/web": "2.0.0-rc.15" }
}
